{
  "name": "pi-research-engineer",
  "version": "0.1.0",
  "description": "A personal Pi package for ML and computational research engineering.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "machine-learning",
    "computational-research",
    "slurm"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "prompt:snapshot": "node --experimental-strip-types scripts/generate-prompt-snapshot.mjs"
  },
  "bin": {
    "pi-research-engineer": "./bin/pi-research.mjs",
    "pre": "./bin/pi-research.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@rynx-ai/tmux": "0.0.0-bootstrap.0",
    "patch-package": "8.0.1",
    "pi-web-access": "0.24.1",
    "yaml": "2.9.0"
  },
  "bundledDependencies": [
    "pi-web-access"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "25.6.2",
    "typebox": "1.1.3",
    "typescript": "6.0.3"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./background-tasks/index.ts",
      "./node_modules/pi-web-access/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bundleDependencies": [
    "pi-web-access"
  ]
}
